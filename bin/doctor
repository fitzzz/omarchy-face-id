#!/usr/bin/env bash

set -u

OUTPUT=json
if [[ ${1:-} == --text ]]; then OUTPUT=text; fi
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  printf 'Usage: %s [--json|--text]\n' "${0##*/}"
  exit 0
fi

OMARCHY_PATH=${OMARCHY_PATH:-/usr/share/omarchy}
LOCK_SERVICE="$OMARCHY_PATH/shell/plugins/lock/Service.qml"
FACE_PAM=/etc/pam.d/omarchy-lock-face

blockers=()

omarchy_version=unknown
if command -v omarchy >/dev/null 2>&1; then
  omarchy_version=$(omarchy version 2>/dev/null || printf unknown)
else
  blockers+=("Omarchy CLI is unavailable")
fi

provider_api=false
if [[ -r $LOCK_SERVICE ]] && grep -Eq 'biometric-provider|biometricProviders|providerApiVersion' "$LOCK_SERVICE"; then
  provider_api=true
else
  blockers+=("Installed Omarchy has no supported biometric-provider API")
fi

# This remains an explicit certification gate. A future supported Omarchy
# version must replace this check with a verified capability marker or API.
lock_reload_safe=false
blockers+=("Omarchy lock-service reload safety is not certified")

gaze_installed=false
gaze_daemon=false
gaze_config=false
gaze_enrolled=false
if command -v gaze >/dev/null 2>&1; then
  gaze_installed=true
  [[ -r /etc/gaze/config.toml ]] && gaze_config=true
  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet gazed.service 2>/dev/null; then
    gaze_daemon=true
  fi
  if gaze list-faces >/dev/null 2>&1; then gaze_enrolled=true; fi
else
  blockers+=("Gaze is not installed")
fi
[[ $gaze_installed == false || $gaze_daemon == true ]] || blockers+=("Gaze daemon is not active")
[[ $gaze_installed == false || $gaze_config == true ]] || blockers+=("Gaze configuration is unavailable")
[[ $gaze_installed == false || $gaze_enrolled == true ]] || blockers+=("No readable Gaze enrollment was found")

pam_service=false
if [[ -r $FACE_PAM ]]; then pam_service=true; else blockers+=("Dedicated face PAM service is unavailable"); fi

camera_available=false
camera_label=""
if command -v v4l2-ctl >/dev/null 2>&1; then
  camera_output=$(v4l2-ctl --list-devices 2>/dev/null || true)
  if [[ $camera_output == *"/dev/video"* ]]; then
    camera_available=true
    camera_label=$(printf '%s\n' "$camera_output" | sed -n '/^[^[:space:]].*:$/ { s/:$//; p; q; }')
  fi
fi
if [[ $camera_available == false ]] && compgen -G '/dev/video*' >/dev/null; then
  camera_available=true
  camera_label="Video4Linux camera"
fi
[[ $camera_available == true ]] || blockers+=("No accessible Video4Linux camera was found")

ready=false
if [[ $provider_api == true && $lock_reload_safe == true && $gaze_installed == true \
      && $gaze_daemon == true && $gaze_config == true && $gaze_enrolled == true \
      && $pam_service == true && $camera_available == true ]]; then
  ready=true
fi

if ((${#blockers[@]} == 0)); then
  blockers_json='[]'
else
  blockers_json=$(printf '%s\n' "${blockers[@]}" | jq -R . | jq -s .)
fi

report=$(jq -n \
  --arg version "$omarchy_version" \
  --arg cameraLabel "$camera_label" \
  --argjson ready "$ready" \
  --argjson providerApi "$provider_api" \
  --argjson lockReloadSafe "$lock_reload_safe" \
  --argjson gazeInstalled "$gaze_installed" \
  --argjson gazeDaemon "$gaze_daemon" \
  --argjson gazeConfig "$gaze_config" \
  --argjson gazeEnrolled "$gaze_enrolled" \
  --argjson pamService "$pam_service" \
  --argjson cameraAvailable "$camera_available" \
  --argjson blockers "$blockers_json" \
  '{
    schemaVersion: 1,
    ready: $ready,
    omarchy: {
      version: $version,
      providerApi: $providerApi,
      lockReloadSafe: $lockReloadSafe
    },
    gaze: {
      installed: $gazeInstalled,
      daemonActive: $gazeDaemon,
      configReadable: $gazeConfig,
      enrollmentReadable: $gazeEnrolled
    },
    pam: { dedicatedFaceService: $pamService },
    camera: { available: $cameraAvailable, label: $cameraLabel },
    blockers: $blockers
  }')

if [[ $OUTPUT == json ]]; then
  printf '%s\n' "$report"
else
  if [[ $ready == true ]]; then
    printf 'READY: face-unlock prerequisites passed\n'
  else
    printf 'DISABLED: face unlock remains safely unavailable\n'
    printf '%s\n' "${blockers[@]/#/- }"
  fi
fi

[[ $ready == true ]]
