#!/usr/bin/env bash

set -euo pipefail

PROJECT_ROOT=$(cd "$(dirname "$0")/.." && pwd)
QML_TEST_RUNTIME=$(mktemp -d /tmp/omarchy-face-unlock-qml.XXXXXX)
chmod 700 "$QML_TEST_RUNTIME"
trap 'rm -rf "$QML_TEST_RUNTIME"' EXIT

printf 'manifest\n'
omarchy plugin validate "$PROJECT_ROOT"

printf 'preflight\n'
python3 -m py_compile \
  "$PROJECT_ROOT/lib/face_unlock_preflight.py" \
  "$PROJECT_ROOT/libexec/omarchy-face-unlock-preflight"
python3 -m unittest discover -s "$PROJECT_ROOT/tests" -p 'test_*.py' -v

printf 'doctor\n'
"$PROJECT_ROOT/tests/test_doctor.sh"

printf 'safety\n'
"$PROJECT_ROOT/tests/test_safety.sh"

printf 'qml\n'
for qml_file in \
  "$PROJECT_ROOT/Service.qml" \
  "$PROJECT_ROOT/PreviewPanel.qml" \
  "$PROJECT_ROOT/components/EyeIndicator.qml" \
  "$PROJECT_ROOT/tests/qml/tst_eye_indicator.qml"; do
  diff -u "$qml_file" <(qmlformat "$qml_file")
done

qmllint -I /usr/share/omarchy/shell \
  "$PROJECT_ROOT/Service.qml" \
  "$PROJECT_ROOT/PreviewPanel.qml" \
  "$PROJECT_ROOT/components/EyeIndicator.qml"

if [[ ${RUN_QML_RUNTIME_TESTS:-0} == 1 ]]; then
  XDG_RUNTIME_DIR="$QML_TEST_RUNTIME" QT_QPA_PLATFORM=offscreen qmltestrunner \
    -import /usr/share/omarchy/shell \
    -input "$PROJECT_ROOT/tests/qml"
else
  printf 'qml runtime tests skipped (set RUN_QML_RUNTIME_TESTS=1 in a Qt Quick test session)\n'
fi

printf 'all checks passed\n'
